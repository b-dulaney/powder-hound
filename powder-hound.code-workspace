{
  "folders": [
    {
      "name": "project-root",
      "path": "./"
    },
    { "name": "sveltekit", "path": "./app" },
    {
      "name": "supabase",
      "path": "./supabase"
    }
  ],
  "settings": {
    "files.exclude": {
      "node_modules/": true,
      "app/": true,
      "supabase/": true
    },
    "deno.enablePaths": ["./supabase"],
    "json.schemas": [
      {
        "fileMatch": ["**/supabase/storage/scraping-config/*.json"],
        "url": "./supabase/storage/scraping-config.schema.json"
      }
    ]
  }
}
